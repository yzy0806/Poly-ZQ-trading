# ZQ–Polymarket Arbitrage Engine environment template
# Copy only the fields you need into a local secret store or a non-synchronized .env file.
# Never put real keys, passwords, passphrases, private keys, or account identifiers in this Git-tracked example.
# Values marked REPLACE_IN_LOCAL_ENV are known fields whose values must be supplied privately.
# Values marked REQUIRED_USER_DECISION require explicit risk or operational approval before trading can be armed.

# =============================================================================
# Application safety and runtime mode
# =============================================================================

# ENV_FILE_VERSION: Schema version used to reject obsolete or incompatible environment files.
ENV_FILE_VERSION=3

# APP_ENV: Application environment label used for logging and configuration selection.
APP_ENV=development

# RUN_MODE: Highest permitted release stage; keep READ_ONLY until separate implementation approval.
RUN_MODE=READ_ONLY

# LIVE_TRADING_ENABLED: Master live-trading gate; false prevents production order submission.
LIVE_TRADING_ENABLED=false

# POLYMARKET_ORDER_SUBMISSION_ENABLED: Independent gate for Polymarket order methods.
POLYMARKET_ORDER_SUBMISSION_ENABLED=false

# IBKR_ORDER_SUBMISSION_ENABLED: Independent gate for IBKR order methods.
IBKR_ORDER_SUBMISSION_ENABLED=false

# OPERATOR_APPROVAL_ID: Audit identifier of the operator approval authorizing the current mode.
OPERATOR_APPROVAL_ID=

# CONFIG_VERSION: Version attached to signals, orders, fills, and audit records.
CONFIG_VERSION=dev-003

# STRATEGY_VERSION: Version of the September 2026 payoff mapping and execution rules.
STRATEGY_VERSION=sep-2026-v1.1

# =============================================================================
# Local API and dashboard
# =============================================================================

# API_HOST: Interface on which the Python FastAPI backend listens; localhost prevents remote access.
API_HOST=127.0.0.1

# API_PORT: TCP port used by the FastAPI backend.
API_PORT=8765

# API_WORKERS: Number of backend processes; version 1 requires one process for deterministic state ownership.
API_WORKERS=1

# DASHBOARD_ORIGIN: Browser origin permitted to access the local backend during development.
DASHBOARD_ORIGIN=http://127.0.0.1:5173

# DASHBOARD_USERNAME: Local operator username; supply privately and do not commit a personal identifier.
DASHBOARD_USERNAME=REPLACE_IN_LOCAL_ENV

# DASHBOARD_PASSWORD: Strong local operator password; store only in the local secret store.
DASHBOARD_PASSWORD=REPLACE_IN_LOCAL_ENV

# SESSION_SIGNING_KEY: Random value of at least 32 bytes used to sign dashboard sessions.
SESSION_SIGNING_KEY=REPLACE_IN_LOCAL_ENV

# CONTROL_CONFIRMATION_SECRET: Separate random secret used for sensitive control confirmations.
CONTROL_CONFIRMATION_SECRET=REPLACE_IN_LOCAL_ENV

# COOKIE_SECURE: Requires HTTPS before browser session cookies are transmitted when true.
COOKIE_SECURE=false

# CORS_ALLOWED_ORIGINS: Comma-separated browser origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# =============================================================================
# Local persistence
# =============================================================================

# RUNTIME_DATA_DIR: Nonsynchronized directory for database, WAL, and transient state; do not place in OneDrive.
RUNTIME_DATA_DIR=D:/ZQ_Polymarket_Runtime

# DATABASE_URL: SQLAlchemy URL for the version-1 local SQLite database.
DATABASE_URL=sqlite+aiosqlite:///D:/ZQ_Polymarket_Runtime/zq_polymarket.db

# LOG_DIR: Nonsynchronized directory for redacted structured logs.
LOG_DIR=D:/ZQ_Polymarket_Runtime/logs

# AUDIT_EXPORT_DIR: Nonsynchronized directory for manually exported audit packages.
AUDIT_EXPORT_DIR=D:/ZQ_Polymarket_Runtime/audit_exports

# SQLITE_BUSY_TIMEOUT_MS: Maximum time SQLite waits for a lock before failing the operation.
SQLITE_BUSY_TIMEOUT_MS=5000

# SQLITE_WAL_AUTOCHECKPOINT_PAGES: WAL page threshold that triggers an automatic checkpoint.
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000

# RETENTION_DAYS_QUOTES: Number of days raw quote snapshots remain in the local database.
RETENTION_DAYS_QUOTES=30

# RETENTION_DAYS_AUDIT: Number of days immutable audit records remain available locally.
RETENTION_DAYS_AUDIT=2555

# =============================================================================
# IBKR TWS or IB Gateway
# =============================================================================

# IBKR_HOST: Host running TWS or IB Gateway.
IBKR_HOST=127.0.0.1

# IBKR_PORT: API socket port currently configured for the running paper TWS/IB Gateway session.
IBKR_PORT=4001

# IBKR_PYTHON_API_PATH: Local path to the official IBKR TWS Python API source installed with TWS API 10.39.1.
IBKR_PYTHON_API_PATH=C:/TWS API/source/pythonclient

# IBKR_CLIENT_ID: Dedicated TWS API client ID reserved for this engine.
IBKR_CLIENT_ID=61

# IBKR_ACCOUNT_ID: Exact broker account code reported by managedAccounts, commonly beginning with DU for paper.
IBKR_ACCOUNT_ID=REPLACE_IN_LOCAL_ENV

# IBKR_TRADING_MODE: Broker environment expected by the engine; paper is the safe initial setting.
IBKR_TRADING_MODE=paper

# IBKR_MARKET_DATA_TYPE: TWS market-data type 1 requires live data and blocks delayed-data trading.
IBKR_MARKET_DATA_TYPE=1

# IBKR_CONNECT_TIMEOUT_SECONDS: Maximum time allowed for the initial API connection and handshake.
IBKR_CONNECT_TIMEOUT_SECONDS=15

# IBKR_HEARTBEAT_SECONDS: Interval between connection-health checks.
IBKR_HEARTBEAT_SECONDS=5

# IBKR_RECONNECT_MAX_ATTEMPTS: Consecutive reconnect attempts allowed before the engine halts.
IBKR_RECONNECT_MAX_ATTEMPTS=5

# IBKR_RECONNECT_BACKOFF_SECONDS: Initial delay between reconnect attempts.
IBKR_RECONNECT_BACKOFF_SECONDS=2

# IBKR_ZQ_EXCHANGE: IBKR exchange code used to qualify 30-Day Federal Funds futures.
IBKR_ZQ_EXCHANGE=CBOT

# IBKR_ZQ_CURRENCY: Contract currency expected during qualification.
IBKR_ZQ_CURRENCY=USD

# IBKR_ZQ_TRADING_CLASS: Trading class expected for the futures contract.
IBKR_ZQ_TRADING_CLASS=ZQ

# IBKR_ZQ_CONTRACT_MONTH: September 2026 contract month in YYYYMM format.
IBKR_ZQ_CONTRACT_MONTH=202609

# IBKR_ZQ_REFERENCE_CONTRACT_MONTHS: Ordered August-November months; first month is the primary pre-meeting EFFR anchor, while all four support the secondary FedWatch diagnostic.
IBKR_ZQ_REFERENCE_CONTRACT_MONTHS=202608,202609,202610,202611

# IBKR_ZQ_CHILD_ORDER_QUANTITY: Mandatory initial child quantity; design policy requires exactly 10 contracts.
IBKR_ZQ_CHILD_ORDER_QUANTITY=10

# IBKR_ZQ_ORDER_TYPE: Capped limit order used instead of an uncapped market order.
IBKR_ZQ_ORDER_TYPE=LMT

# IBKR_ZQ_TIME_IN_FORCE: Default lifetime of the ZQ limit order during its trading session.
IBKR_ZQ_TIME_IN_FORCE=DAY

# IBKR_ZQ_AUTO_REPRICE_ENABLED: Version 1 leaves a working ZQ order at its original limit and never chases the market.
IBKR_ZQ_AUTO_REPRICE_ENABLED=false

# IBKR_ZQ_MAX_PRICE_REVISIONS: Zero enforces the approved version-1 no-chase/no-reprice rule.
IBKR_ZQ_MAX_PRICE_REVISIONS=0

# IBKR_ZQ_PRICE_REVISION_SECONDS: Zero because automated ZQ price revision is disabled in version 1.
IBKR_ZQ_PRICE_REVISION_SECONDS=0

# =============================================================================
# Polymarket public endpoints
# =============================================================================

# POLYMARKET_CLOB_HOST: Official CLOB REST endpoint for books, orders, and trades.
POLYMARKET_CLOB_HOST=https://clob.polymarket.com

# POLYMARKET_DATA_API_HOST: Official positions and activity API endpoint.
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com

# POLYMARKET_GAMMA_API_HOST: Official event and market metadata API endpoint.
POLYMARKET_GAMMA_API_HOST=https://gamma-api.polymarket.com

# POLYMARKET_RELAYER_HOST: Official endpoint for gasless on-chain wallet transactions.
POLYMARKET_RELAYER_HOST=https://relayer-v2.polymarket.com

# POLYMARKET_MARKET_WS_URL: Public WebSocket carrying order-book and market updates.
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# POLYMARKET_USER_WS_URL: Authenticated WebSocket carrying private order and trade updates.
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

# POLYMARKET_GEOBLOCK_URL: Official endpoint checked before arming and periodically thereafter.
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock

# POLYMARKET_CHAIN_ID: Polygon mainnet chain ID used by Polymarket.
POLYMARKET_CHAIN_ID=137

# POLYGON_RPC_URL: Optional in version 1; required only for separately authorized independent on-chain checks or wallet transactions.
POLYGON_RPC_URL=

# =============================================================================
# Polymarket wallet and CLOB L2 credentials
# =============================================================================

# POLYMARKET_PRIVATE_KEY: L1 signing key; never store it in this file, Git, OneDrive, logs, or browser storage.
POLYMARKET_PRIVATE_KEY=REPLACE_IN_LOCAL_SECRET_STORE

# POLYMARKET_SIGNER_ADDRESS: Public address shown as the signer for the supplied Polymarket API configuration.
POLYMARKET_SIGNER_ADDRESS=0x0E59de23e05F128E28209F8eCf3952886caa68E3

# POLYMARKET_FUNDER_ADDRESS: Wallet or deposit-wallet address that actually holds collateral and outcome tokens.
POLYMARKET_FUNDER_ADDRESS=REPLACE_IN_LOCAL_ENV

# POLYMARKET_SIGNATURE_TYPE: AUTO makes the official SDK classify and verify the signer-funder relationship before enabling orders.
POLYMARKET_SIGNATURE_TYPE=AUTO

# POLYMARKET_CREDENTIAL_NONCE: Nonce used when creating or deriving the CLOB L2 credential set.
POLYMARKET_CREDENTIAL_NONCE=0

# POLYMARKET_API_KEY: CLOB L2 API key; this is not the Relayer key or Builder key shown in the screenshots.
POLYMARKET_API_KEY=REPLACE_IN_LOCAL_ENV

# POLYMARKET_API_SECRET: Base64 CLOB L2 HMAC secret paired with POLYMARKET_API_KEY.
POLYMARKET_API_SECRET=REPLACE_IN_LOCAL_ENV

# POLYMARKET_API_PASSPHRASE: CLOB L2 passphrase paired with the CLOB API key and secret.
POLYMARKET_API_PASSPHRASE=REPLACE_IN_LOCAL_ENV

# =============================================================================
# Polymarket Relayer credentials
# =============================================================================

# POLYMARKET_RELAYER_ENABLED: Enables optional gasless wallet operations; ordinary CLOB order posting does not require it.
POLYMARKET_RELAYER_ENABLED=false

# POLYMARKET_RELAYER_API_KEY: Relayer key shown in Settings; keep the real value only in a local secret store.
POLYMARKET_RELAYER_API_KEY=REPLACE_IN_LOCAL_ENV

# POLYMARKET_RELAYER_API_KEY_ADDRESS: Public address that owns the supplied Relayer API key.
POLYMARKET_RELAYER_API_KEY_ADDRESS=0x0E59de23e05F128E28209F8eCf3952886caa68E3

# POLYMARKET_RELAYER_TX_TYPE: Optional SAFE or PROXY value used only if the separately disabled Relayer path is later enabled.
POLYMARKET_RELAYER_TX_TYPE=

# =============================================================================
# Polymarket Builder credentials and CLOB V2 attribution
# =============================================================================

# POLYMARKET_BUILDER_API_KEY: Builder HMAC API key from the second screenshot; never commit the real value.
POLYMARKET_BUILDER_API_KEY=REPLACE_IN_LOCAL_ENV

# POLYMARKET_BUILDER_API_SECRET: Builder HMAC secret paired with the Builder API key.
POLYMARKET_BUILDER_API_SECRET=REPLACE_IN_LOCAL_ENV

# POLYMARKET_BUILDER_API_PASSPHRASE: Builder HMAC passphrase paired with the Builder API key and secret.
POLYMARKET_BUILDER_API_PASSPHRASE=REPLACE_IN_LOCAL_ENV

# POLYMARKET_BUILDER_CODE: Optional CLOB V2 attribution code; leave blank when builder attribution is not required.
POLYMARKET_BUILDER_CODE=

# =============================================================================
# September 2026 event-level mapping verified from the official Gamma API
# =============================================================================

# POLYMARKET_EVENT_ID: Public Gamma event identifier.
POLYMARKET_EVENT_ID=481717

# POLYMARKET_EVENT_SLUG: Public event slug from the supplied Polymarket URL.
POLYMARKET_EVENT_SLUG=fed-decision-in-september-762

# POLYMARKET_EVENT_URL: Public Polymarket event page supplied for the September 2026 FOMC decision.
POLYMARKET_EVENT_URL=https://polymarket.com/event/fed-decision-in-september-762

# POLYMARKET_EVENT_TITLE: Human-readable title used only for display and reconciliation.
POLYMARKET_EVENT_TITLE="Fed Decision in September?"

# POLYMARKET_EVENT_START_UTC: Event creation/start timestamp reported by Gamma.
POLYMARKET_EVENT_START_UTC=2026-05-13T21:23:09.737806Z

# POLYMARKET_EVENT_END_UTC: Event end timestamp reported by Gamma.
POLYMARKET_EVENT_END_UTC=2026-09-16T00:00:00Z

# POLYMARKET_EVENT_MARKET_COUNT: Number of mutually exclusive outcome markets in the event.
POLYMARKET_EVENT_MARKET_COUNT=5

# POLYMARKET_EVENT_NEG_RISK: Identifies this as a negative-risk multi-outcome event.
POLYMARKET_EVENT_NEG_RISK=true

# POLYMARKET_EVENT_RULE_SHA256: SHA-256 of the exact UTF-8 Gamma description with no trailing newline.
POLYMARKET_EVENT_RULE_SHA256=603ed540a4e11d06f26a44d76c8e94806741e666e62f88e25625a87f08e54891

# POLYMARKET_EVENT_RULE_HASH_CANONICALIZATION: Documents how the rule hash above is reproduced.
POLYMARKET_EVENT_RULE_HASH_CANONICALIZATION=UTF8_GAMMA_DESCRIPTION_NO_TRAILING_NEWLINE

# POLYMARKET_RESOLUTION_CALENDAR_URL: Official Federal Reserve calendar cited by the market rules.
POLYMARKET_RESOLUTION_CALENDAR_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm

# POLYMARKET_RESOLUTION_STATEMENT_URL: Official Federal Reserve policy statement source cited by the market rules.
POLYMARKET_RESOLUTION_STATEMENT_URL=https://www.federalreserve.gov/monetarypolicy/openmarket.htm

