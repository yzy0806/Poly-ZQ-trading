# =============================================================================
# Default Polymarket hedge execution
# =============================================================================

# POLYMARKET_DEFAULT_ORDER_TYPE: GTC keeps the maker order resting until fill, cancel, or replacement.
POLYMARKET_DEFAULT_ORDER_TYPE=GTC

# POLYMARKET_POST_ONLY: Guarantees the default hedge order cannot take resting liquidity.
POLYMARKET_POST_ONLY=true

# POLYMARKET_POST_ONLY_REPRICE_SECONDS: Initial paper/shadow interval before canceling and reposting the residual.
POLYMARKET_POST_ONLY_REPRICE_SECONDS=5

# POLYMARKET_POST_ONLY_MAX_REPRICES: Initial maximum number of passive cancel-and-repost attempts.
POLYMARKET_POST_ONLY_MAX_REPRICES=3

# POLYMARKET_HARD_PRICE_CAP: Maximum permitted normal-path buy price; requires an approved strategy value.
POLYMARKET_HARD_PRICE_CAP=0.95

# POLYMARKET_CANCEL_CONFIRM_TIMEOUT_SECONDS: Time allowed to confirm cancellation before entering uncertain-order recovery.
POLYMARKET_CANCEL_CONFIRM_TIMEOUT_SECONDS=3

# POLYMARKET_USER_WS_PING_SECONDS: Application heartbeat interval required by the authenticated user WebSocket.
POLYMARKET_USER_WS_PING_SECONDS=10

# POLYMARKET_RECONNECT_MAX_ATTEMPTS: Consecutive Polymarket reconnect attempts before halting.
POLYMARKET_RECONNECT_MAX_ATTEMPTS=5

# POLYMARKET_RECONNECT_BACKOFF_SECONDS: Initial delay between Polymarket reconnect attempts.
POLYMARKET_RECONNECT_BACKOFF_SECONDS=2

# POLYMARKET_BOOK_SNAPSHOT_INTERVAL_SECONDS: REST seed/reconciliation interval; live L2 changes come directly from the market WebSocket rather than polling.
POLYMARKET_BOOK_SNAPSHOT_INTERVAL_SECONDS=30

# POLYMARKET_EMERGENCY_ORDER_TYPE: FAK may cross only under the separately approved emergency policy.
POLYMARKET_EMERGENCY_ORDER_TYPE=FAK

# POLYMARKET_EMERGENCY_MAX_PRICE: Absolute emergency buy cap requiring explicit operator approval.
POLYMARKET_EMERGENCY_MAX_PRICE=0.99

# POLYMARKET_HEDGE_ROUNDING_MODE: Rounds obligations upward where that reduces the defined uncovered tail.
POLYMARKET_HEDGE_ROUNDING_MODE=ROUND_UP

# =============================================================================
# Strategy qualification and hard risk limits
# =============================================================================

# MIN_NET_PROFIT_USD: Minimum conservative terminal profit after all costs and reserves.
MIN_NET_PROFIT_USD=250

# MIN_RETURN_ON_CAPITAL_BPS: Minimum conservative profit divided by committed capital, in basis points.
MIN_RETURN_ON_CAPITAL_BPS=300

# MAX_ZQ_POSITION: Aggregate version-1 ZQ cap reached only through sequential reconciled 10-contract batches.
MAX_ZQ_POSITION=100

# MAX_OPEN_BATCHES: Maximum simultaneous execution batches; version 1 permits only one.
MAX_OPEN_BATCHES=1

# MAX_UNHEDGED_ZQ_CONTRACTS: Maximum filled ZQ contracts allowed before corresponding confirmed hedges.
MAX_UNHEDGED_ZQ_CONTRACTS=10

# MAX_UNHEDGED_SECONDS: Maximum age of any uncovered ZQ fill before emergency handling.
MAX_UNHEDGED_SECONDS=15

# MAX_ZQ_SLIPPAGE_TICKS: Maximum adverse ZQ execution movement from the qualified price.
MAX_ZQ_SLIPPAGE_TICKS=1

# MAX_POLYMARKET_PRICE_SLIPPAGE: Maximum adverse Polymarket price movement from the qualified passive price.
MAX_POLYMARKET_PRICE_SLIPPAGE=0.01

# MIN_FULL_EXCESS_LIQUIDITY_USD: Minimum projected IBKR full excess liquidity after the order.
MIN_FULL_EXCESS_LIQUIDITY_USD=10000

# MIN_EXCESS_LIQUIDITY_MARGIN_MULTIPLIER: Dynamic floor expressed as a multiple of next-batch incremental initial margin; the larger floor governs.
MIN_EXCESS_LIQUIDITY_MARGIN_MULTIPLIER=10

# MIN_MARGIN_CUSHION_RATIO: Minimum projected broker margin cushion expressed as a decimal ratio.
MIN_MARGIN_CUSHION_RATIO=0.50

# MAX_DAILY_LOSS_USD: Daily combined strategy-loss threshold that halts trading.
MAX_DAILY_LOSS_USD=500

# MAX_STRATEGY_DRAWDOWN_USD: Peak-to-trough strategy drawdown threshold that halts trading.
MAX_STRATEGY_DRAWDOWN_USD=2000

# TAIL_LOSS_GATE_ENABLED: Version 1 intentionally excludes +75 and +100 bp scenarios from calculation and gating.
TAIL_LOSS_GATE_ENABLED=false

# MAX_TAIL_LOSS_USD: Unset while the version-1 tail-loss gate is disabled.
MAX_TAIL_LOSS_USD=

# MAX_QUOTE_AGE_MS: Maximum age of the live IBKR target and pre-meeting anchor quotes; quiet Polymarket books use WebSocket synchronization state instead of change age.
MAX_QUOTE_AGE_MS=500

# MAX_CROSS_VENUE_TIMESTAMP_SKEW_MS: Reserved diagnostic ceiling for timestamp-arrival analysis; qualification uses one immutable snapshot plus live IBKR freshness and Polymarket WebSocket synchronization.
MAX_CROSS_VENUE_TIMESTAMP_SKEW_MS=250

# MAX_CLOCK_DRIFT_MS: Maximum system-clock drift allowed before trading is blocked.
MAX_CLOCK_DRIFT_MS=100

# MODEL_RISK_RESERVE_USD: Development-only zero; LIMITED_LIVE and LIVE_ARMED validation must reject zero until a replacement is approved.
MODEL_RISK_RESERVE_USD=0

# OPERATIONAL_RISK_RESERVE_USD: Development-only zero; LIMITED_LIVE and LIVE_ARMED validation must reject zero until a replacement is approved.
OPERATIONAL_RISK_RESERVE_USD=0

# EFFR_BASIS_RESERVE_USD: Development-only zero; LIMITED_LIVE and LIVE_ARMED validation must reject zero until a replacement is approved.
EFFR_BASIS_RESERVE_USD=0

# =============================================================================
# Event-time controls and display time zones
# =============================================================================

# INTERNAL_TIMEZONE: Canonical timezone used for persistence and calculations.
INTERNAL_TIMEZONE=UTC

# OPERATOR_TIMEZONE: Timezone shown to the local operator.
OPERATOR_TIMEZONE=Asia/Taipei

# FOMC_TIMEZONE: Timezone used to interpret FOMC event timestamps.
FOMC_TIMEZONE=America/New_York

# CME_TIMEZONE: Timezone used for CME/CBOT session and cutoff context.
CME_TIMEZONE=America/Chicago

# FOMC_TRADING_CUTOFF_UTC: UTC timestamp after which new event trades are prohibited.
FOMC_TRADING_CUTOFF_UTC=2026-09-16T17:00:00Z

# FOMC_STATEMENT_UTC: Scheduled September decision timestamp after which this version never starts another event batch.
FOMC_STATEMENT_UTC=2026-09-16T18:00:00Z

# FOMC_POST_DECISION_RESUME_ENABLED: Version 1 never resumes new batches after the September decision.
FOMC_POST_DECISION_RESUME_ENABLED=false

# FOMC_TRADING_RESUME_UTC: Unset because post-decision resumption is disabled for this event.
FOMC_TRADING_RESUME_UTC=

# GEOBLOCK_REFRESH_SECONDS: Interval between official eligibility checks while the service is running.
GEOBLOCK_REFRESH_SECONDS=300

# =============================================================================
# Logging, metrics, alerts, and redaction
# =============================================================================

# LOG_LEVEL: Minimum structured-log severity emitted by the service.
LOG_LEVEL=INFO

# LOG_FORMAT: Machine-readable log encoding used by the backend.
LOG_FORMAT=json

# LOG_REDACT_SECRETS: Forces credential, signature, and authorization-header redaction.
LOG_REDACT_SECRETS=true

# PROMETHEUS_ENABLED: Enables the localhost metrics endpoint.
PROMETHEUS_ENABLED=true

# PROMETHEUS_HOST: Interface on which metrics are exposed.
PROMETHEUS_HOST=127.0.0.1

# PROMETHEUS_PORT: TCP port for the local metrics endpoint.
PROMETHEUS_PORT=9108

# ALERT_WEBHOOK_URL: Optional private webhook for critical alerts; leave blank if unused.
ALERT_WEBHOOK_URL=

# ALERT_EMAIL_TO: Optional alert-recipient address; leave blank if unused.
ALERT_EMAIL_TO=

# SOFTWARE_VERSION: Build version displayed on the dashboard and written to audit records.
SOFTWARE_VERSION=dev

# ENGINE_STATE_PUBLISH_INTERVAL_MS: Maximum interval between authoritative dashboard state publications.
ENGINE_STATE_PUBLISH_INTERVAL_MS=500

# EVENT_QUEUE_MAXSIZE: Bounded in-process event queue capacity; overflow is a hard halt.
EVENT_QUEUE_MAXSIZE=10000

# DASHBOARD_SESSION_MAX_AGE_SECONDS: Maximum authenticated dashboard session age before re-login.
DASHBOARD_SESSION_MAX_AGE_SECONDS=28800

# =============================================================================
# Development, simulation, and test controls
# =============================================================================

# SIMULATE_POLYMARKET_FILLS: Uses deterministic simulated fills instead of sending Polymarket orders.
SIMULATE_POLYMARKET_FILLS=true

# USE_RECORDED_MARKET_DATA: Replays a recorded dataset instead of live venue feeds when true.
USE_RECORDED_MARKET_DATA=false

# RECORDED_MARKET_DATA_PATH: Local path to the replay dataset when recorded-data mode is enabled.
RECORDED_MARKET_DATA_PATH=

# DETERMINISTIC_RANDOM_SEED: Seed used by execution and failure simulators for reproducible tests.
DETERMINISTIC_RANDOM_SEED=20260916

# FAIL_ON_UNKNOWN_ENV_VAR: Rejects misspelled or unsupported environment variables at startup.
FAIL_ON_UNKNOWN_ENV_VAR=true
