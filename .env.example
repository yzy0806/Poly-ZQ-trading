# ZQ–Polymarket Arbitrage Engine environment template
# Copy this file to .env and fill the required values locally.
# Never commit .env, share it in chat, or place real secrets in screenshots or logs.
# Blank REQUIRED values must prevent the backend from arming.

# -----------------------------------------------------------------------------
# Application safety and runtime mode
# -----------------------------------------------------------------------------
ENV_FILE_VERSION=1
APP_ENV=development
RUN_MODE=READ_ONLY
LIVE_TRADING_ENABLED=false
POLYMARKET_ORDER_SUBMISSION_ENABLED=false
IBKR_ORDER_SUBMISSION_ENABLED=false
OPERATOR_APPROVAL_ID=
CONFIG_VERSION=dev-001
STRATEGY_VERSION=sep-2026-v1

# -----------------------------------------------------------------------------
# Local API and dashboard
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
DASHBOARD_ORIGIN=http://127.0.0.1:5173
DASHBOARD_USERNAME=yingz2012
DASHBOARD_PASSWORD=Yonghuili1!
SESSION_SIGNING_KEY=7f3e9a2c1b5d8e4f6a9c2b7e3f1a5d8e
CONTROL_CONFIRMATION_SECRET=a_secure_random_string
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Local persistence; use a nonsynchronized local disk, not OneDrive
# -----------------------------------------------------------------------------
RUNTIME_DATA_DIR=D:/ZQ_Polymarket_Runtime
DATABASE_URL=sqlite+aiosqlite:///D:/ZQ_Polymarket_Runtime/zq_polymarket.db
LOG_DIR=D:/ZQ_Polymarket_Runtime/logs
AUDIT_EXPORT_DIR=D:/ZQ_Polymarket_Runtime/audit_exports
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
RETENTION_DAYS_QUOTES=30
RETENTION_DAYS_AUDIT=2555

# -----------------------------------------------------------------------------
# IBKR TWS or IB Gateway
# TWS paper default is 7497; TWS live is commonly 7496.
# IB Gateway paper is commonly 4002; IB Gateway live is commonly 4001.
# Confirm the port in your own TWS or Gateway API settings.
# Do not put an IBKR portal username or password in this file.
# -----------------------------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=61
IBKR_ACCOUNT_ID=yingz2012tvpaper
IBKR_TRADING_MODE=paper
IBKR_MARKET_DATA_TYPE=1
IBKR_CONNECT_TIMEOUT_SECONDS=15
IBKR_HEARTBEAT_SECONDS=5
IBKR_RECONNECT_MAX_ATTEMPTS=5
IBKR_RECONNECT_BACKOFF_SECONDS=2
IBKR_ZQ_EXCHANGE=CBOT
IBKR_ZQ_CURRENCY=USD
IBKR_ZQ_TRADING_CLASS=ZQ
IBKR_ZQ_CONTRACT_MONTH=202609
IBKR_ZQ_CHILD_ORDER_QUANTITY=10
IBKR_ZQ_ORDER_TYPE=LMT
IBKR_ZQ_TIME_IN_FORCE=DAY
IBKR_ZQ_MAX_PRICE_REVISIONS=REQUIRED
IBKR_ZQ_PRICE_REVISION_SECONDS=REQUIRED

# -----------------------------------------------------------------------------
# Polymarket public endpoints
# -----------------------------------------------------------------------------
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com
POLYMARKET_GAMMA_API_HOST=https://gamma-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYMARKET_CHAIN_ID=137

# -----------------------------------------------------------------------------
# Polymarket wallet and L2 API credentials
# Fill signature type and funder address according to your actual wallet type.
# The private key controls L1 order signing and must remain local.
# -----------------------------------------------------------------------------
POLYMARKET_PRIVATE_KEY=REPLACE_ME
POLYMARKET_SIGNER_ADDRESS=REPLACE_ME
POLYMARKET_FUNDER_ADDRESS=REPLACE_ME
POLYMARKET_SIGNATURE_TYPE=REQUIRED
POLYMARKET_CREDENTIAL_NONCE=0
POLYMARKET_API_KEY=01a01503-7e58-7c5d-83fb-1c6239892ec8
POLYMARKET_API_SECRET=REPLACE_ME
POLYMARKET_API_PASSPHRASE=REPLACE_ME

# -----------------------------------------------------------------------------
# Approved Polymarket market mapping: September 2026 strategy
# Titles are insufficient; IDs and rule hashes must be independently approved.
# -----------------------------------------------------------------------------
POLYMARKET_EVENT_SLUG=REPLACE_ME

POLYMARKET_EXACT25_MARKET_SLUG=REPLACE_ME
POLYMARKET_EXACT25_CONDITION_ID=REPLACE_ME
POLYMARKET_EXACT25_YES_TOKEN_ID=REPLACE_ME
POLYMARKET_EXACT25_NO_TOKEN_ID=REPLACE_ME
POLYMARKET_EXACT25_RULE_SHA256=REPLACE_ME

POLYMARKET_50PLUS_MARKET_SLUG=REPLACE_ME
POLYMARKET_50PLUS_CONDITION_ID=REPLACE_ME
POLYMARKET_50PLUS_YES_TOKEN_ID=REPLACE_ME
POLYMARKET_50PLUS_NO_TOKEN_ID=REPLACE_ME
POLYMARKET_50PLUS_RULE_SHA256=REPLACE_ME

POLYMARKET_EXPECTED_NEG_RISK=false
POLYMARKET_EXPECTED_TICK_SIZE=
POLYMARKET_EXPECTED_MIN_ORDER_SIZE=

# -----------------------------------------------------------------------------
# Default Polymarket hedge execution
# The normal path is a GTC post-only BUY at the highest permissible maker price.
# Marketable execution is emergency-only and requires separate approval.
# -----------------------------------------------------------------------------
POLYMARKET_DEFAULT_ORDER_TYPE=GTC
POLYMARKET_POST_ONLY=true
POLYMARKET_POST_ONLY_REPRICE_SECONDS=REQUIRED
POLYMARKET_POST_ONLY_MAX_REPRICES=REQUIRED
POLYMARKET_HARD_PRICE_CAP=REQUIRED
POLYMARKET_CANCEL_CONFIRM_TIMEOUT_SECONDS=REQUIRED
POLYMARKET_USER_WS_PING_SECONDS=10
POLYMARKET_RECONNECT_MAX_ATTEMPTS=5
POLYMARKET_RECONNECT_BACKOFF_SECONDS=2
POLYMARKET_EMERGENCY_ORDER_TYPE=FAK
POLYMARKET_EMERGENCY_MAX_PRICE=REQUIRED
POLYMARKET_HEDGE_ROUNDING_MODE=ROUND_UP

# -----------------------------------------------------------------------------
# Strategy qualification and hard risk limits
# REQUIRED values need explicit operator approval before PAPER or LIVE mode.
# -----------------------------------------------------------------------------
MIN_NET_PROFIT_USD=REQUIRED
MIN_RETURN_ON_CAPITAL_BPS=REQUIRED
MAX_ZQ_POSITION=REQUIRED
MAX_OPEN_BATCHES=1
MAX_UNHEDGED_ZQ_CONTRACTS=REQUIRED
MAX_UNHEDGED_SECONDS=REQUIRED
MAX_ZQ_SLIPPAGE_TICKS=REQUIRED
MAX_POLYMARKET_PRICE_SLIPPAGE=REQUIRED
MIN_FULL_EXCESS_LIQUIDITY_USD=REQUIRED
MIN_MARGIN_CUSHION_RATIO=REQUIRED
MAX_DAILY_LOSS_USD=REQUIRED
MAX_STRATEGY_DRAWDOWN_USD=REQUIRED
MAX_TAIL_LOSS_USD=REQUIRED
MAX_QUOTE_AGE_MS=REQUIRED
MAX_CROSS_VENUE_TIMESTAMP_SKEW_MS=REQUIRED
MAX_CLOCK_DRIFT_MS=REQUIRED
MODEL_RISK_RESERVE_USD=REQUIRED
OPERATIONAL_RISK_RESERVE_USD=REQUIRED
EFFR_BASIS_RESERVE_USD=REQUIRED

# -----------------------------------------------------------------------------
# Event-time controls and display time zones
# -----------------------------------------------------------------------------
INTERNAL_TIMEZONE=UTC
OPERATOR_TIMEZONE=Asia/Taipei
FOMC_TIMEZONE=America/New_York
CME_TIMEZONE=America/Chicago
FOMC_TRADING_CUTOFF_UTC=REQUIRED
FOMC_TRADING_RESUME_UTC=REQUIRED
GEOBLOCK_REFRESH_SECONDS=300

# -----------------------------------------------------------------------------
# Logging, metrics, alerts, and redaction
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REDACT_SECRETS=true
PROMETHEUS_ENABLED=true
PROMETHEUS_HOST=127.0.0.1
PROMETHEUS_PORT=9108
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
SOFTWARE_VERSION=dev

# -----------------------------------------------------------------------------
# Development, simulation, and test controls
# -----------------------------------------------------------------------------
SIMULATE_POLYMARKET_FILLS=true
USE_RECORDED_MARKET_DATA=false
RECORDED_MARKET_DATA_PATH=
DETERMINISTIC_RANDOM_SEED=20260916
FAIL_ON_UNKNOWN_ENV_VAR=true
