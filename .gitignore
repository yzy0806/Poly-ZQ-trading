# Local environment files may contain credentials and must never be committed.
.env
.env.*
*.env
# These are deliberately non-secret configuration sources.
!/deploy/zq-arb.env.example
!/tests/fixtures/september-2026.env

# Machine-specific overrides for production deployment tooling.
/compose.override.yml
/compose.override.yaml
/docker-compose.override.yml
/docker-compose.override.yaml

# Common private-key and certificate formats.
*.key
*.pem
*.p12
*.pfx
secrets/

# Python runtime artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-user-temp/
.hypothesis/
.coverage*
htmlcov/
.mypy_cache/
.ruff_cache/
.uv-cache/
.venv*/
venv/
*.egg-info/

# Local runtime state and logs.
runtime/
logs/
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.log

# Frontend dependencies and build output.
node_modules/
dist/
coverage/
.playwright-cli/
output/
artifacts/
*.tsbuildinfo

# Editor and operating-system metadata.
.vscode/
.idea/
.DS_Store
Thumbs.db

# macOS resource forks and local scratch files.
._*
*.swp
*.swo
