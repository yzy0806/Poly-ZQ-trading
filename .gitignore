# Local environment files may contain credentials and must never be committed.
.env
.env.*

# Common private-key and certificate formats.
*.key
*.pem
*.p12
*.pfx
secrets/

# Python runtime artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-user-temp/
.hypothesis/
.coverage*
htmlcov/
.mypy_cache/
.ruff_cache/
.uv-cache/
.venv*/
venv/
*.egg-info/

# Local runtime state and logs.
runtime/
logs/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log

# Frontend dependencies and build output.
node_modules/
dist/
coverage/
.playwright-cli/
output/
artifacts/
*.tsbuildinfo

# Editor and operating-system metadata.
.vscode/
.idea/
.DS_Store
Thumbs.db
