# Safe deployment template. The bootstrap script generates the three dashboard secrets.
ENV_FILE_VERSION=9
APP_ENV=production
RUN_MODE=READ_ONLY
LIVE_TRADING_ENABLED=false
POLYMARKET_ORDER_SUBMISSION_ENABLED=false
IBKR_ORDER_SUBMISSION_ENABLED=false
OPERATOR_APPROVAL_ID=
CONFIG_VERSION=staging-001
STRATEGY_VERSION=sep-2026-v1.6

API_HOST=0.0.0.0
API_PORT=8765
API_WORKERS=1
DASHBOARD_ORIGIN=https://trade.cardiuscapital.com
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=GENERATED_BY_BOOTSTRAP
SESSION_SIGNING_KEY=GENERATED_BY_BOOTSTRAP
CONTROL_CONFIRMATION_SECRET=GENERATED_BY_BOOTSTRAP
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://trade.cardiuscapital.com
DASHBOARD_SESSION_MAX_AGE_SECONDS=28800

RUNTIME_DATA_DIR=/var/lib/zq-arb
DATABASE_URL=sqlite+aiosqlite:////var/lib/zq-arb/engine.sqlite3
LOG_DIR=/var/lib/zq-arb/logs
AUDIT_EXPORT_DIR=/var/lib/zq-arb/audit
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
RETENTION_DAYS_QUOTES=30
RETENTION_DAYS_AUDIT=2555

IBKR_HOST=ib-gateway
IBKR_PORT=4004
IBKR_PYTHON_API_PATH=/opt/ibapi
IBKR_CLIENT_ID=61
IBKR_ACCOUNT_ID=
IBKR_TRADING_MODE=paper
IBKR_MARKET_DATA_TYPE=1
IBKR_CONNECT_TIMEOUT_SECONDS=15
IBKR_HEARTBEAT_SECONDS=5
IBKR_RECONNECT_MAX_ATTEMPTS=5
IBKR_RECONNECT_BACKOFF_SECONDS=2
IBKR_ZQ_EXCHANGE=CBOT
IBKR_ZQ_CURRENCY=USD
IBKR_ZQ_TRADING_CLASS=ZQ
IBKR_ZQ_CONTRACT_MONTH=202609
IBKR_ZQ_SUBSCRIPTION_MONTHS=202609,202610,202611
IBKR_ZQ_CHILD_ORDER_QUANTITY=10
IBKR_ZQ_ORDER_TYPE=LMT
IBKR_ZQ_TIME_IN_FORCE=DAY
